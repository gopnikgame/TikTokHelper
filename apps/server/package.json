{
  "name": "@tiktok-helper/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "catalog:",
    "@tiktok-helper/contracts": "workspace:*",
    "drizzle-orm": "catalog:",
    "fastify": "5.12.4",
    "postgres": "catalog:",
    "proxy-agent": "catalog:",
    "tiktok-live-connector": "catalog:"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "drizzle-kit": "catalog:",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
