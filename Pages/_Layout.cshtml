<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TikTokHelper</title>
    <!-- Подключаем локальный Bootstrap CSS -->
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand ajax-link" href="/">TikTokHelper</a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ml-auto">
                        <li class="nav-item">
                            <a class="nav-link ajax-link" asp-page="/Index">Мониторинг</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link ajax-link" asp-page="/Sound/Index">Привязки звуков</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link ajax-link" asp-page="/Settings/Index">Настройки озвучки</a>
                        </li>
                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-page="/Admin/Users">Управление пользователями</a>
                            </li>
                        }
                    </ul>
                    <!-- Добавляем частичное представление для логина/логаута -->
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <main id="mainContent" role="main" class="pb-3">
        @RenderBody()
    </main>
    <footer class="footer">
        <div class="container">
            &copy; 2023 - TikTokHelper - <a asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <!-- Подключаем скрипты -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/socket.io/socket.io.js"></script>
    <script src="~/js/tiktok-events.js"></script>
    <script src="~/js/sound-manager.js"></script>
    <script src="~/js/refresh-gifts.js"></script>
    <script src="~/js/VoiceAnnouncer.js"></script>
    <script src="~/js/speek-page-view.js"></script>
    <script src="~/js/speek-monitoring.js"></script>
    <script>
        $(document).ready(function () {
            // Делегируем событие клика для ссылок с классом ajax-link
            $(document).on('click', 'a.ajax-link', function (e) {
                e.preventDefault();
                $('body').addClass('loading');
                var url = $(this).attr('href');
                $("#mainContent").addClass('loading').load(url + " #mainContent>*", function (response, status, xhr) {
                    if (status === "error") {
                        console.error("Ошибка загрузки контента: " + xhr.status + " " + xhr.statusText);
                    } else {
                        var newTitle = $(response).filter('title').text();
                        if (newTitle) {
                            document.title = newTitle;
                        }
                        // Генерируем событие для переинициализации скриптов при ajax-переходе
                        document.dispatchEvent(new CustomEvent('ajaxPageLoaded'));
                    }
                    $('body').removeClass('loading');
                    $("#mainContent").removeClass('loading');
                });
                history.pushState(null, null, url);
            });

            window.onpopstate = function (e) {
                $("#mainContent").load(location.href + " #mainContent>*", function () {
                    document.dispatchEvent(new CustomEvent('ajaxPageLoaded'));
                });
            };
        });
    </script>

    @RenderSection("Scripts", required: false)

    <!-- Индикатор загрузки AJAX -->
    <div class="ajax-loading spinner-border text-primary" role="status">
        <span class="sr-only">Loading...</span>
    </div>
</body>
</html>
