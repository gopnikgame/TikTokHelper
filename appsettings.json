{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source={DataDirectory}/tiktokhelper.db"
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "targets": {
      "logfile": {
        "type": "File",
        "fileName": "${basedir}/data/logs/${shortdate}/app.log",
        "archiveFileName": "${basedir}/data/logs/archives/app.{#}.log",
        "archiveEvery": "Day",
        "archiveNumbering": "Rolling",
        "maxArchiveFiles": 7,
        "layout": "${longdate} ${level:uppercase=true} [${logger}] ${message} ${exception:format=toString,StackTrace}"
      },
      "logconsole": {
        "type": "Console",
        "layout": "${longdate} ${level:uppercase=true} [${logger}] ${message}"
      },
      "loglostconnection": {
        "type": "File",
        "fileName": "${basedir}/data/logs/connections.log",
        "layout": "${longdate} ${level} [${logger}] ${message}"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "logconsole"
      },
      {
        "logger": "TikTokHelper_Electron.Services.NodeJsService",
        "minLevel": "Debug",
        "writeTo": "logconsole,logfile"
      },
      {
        "logger": "*",
        "minLevel": "Error",
        "writeTo": "logfile"
      },
      {
        "logger": "*TikTok*",
        "minLevel": "Warn",
        "writeTo": "loglostconnection"
      }
    ]
  },
  "NodeJsService": {
    "WebSocketServerHost": "0.0.0.0",
    "WebSocketServerPort": 3000
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:80"
      }
    },
    "ForwardedHeaders": {
      "Enabled": true,
      "ForwardLimit": 2
    }
  },
  "AppConfig": {
    "BaseDomain": "monitoring.tik-talk.ru",
    "EnableHTTPS": true,
    "DataDirectory": "data",
    "DefaultAdminEmail": "info@vpnline.online"
  },
  "Identity": {
    "RequireConfirmedAccount": false,
    "RequireUniqueEmail": true,
    "RequireConfirmedEmail": false,
    "Password": {
      "RequireDigit": true,
      "RequiredLength": 8,
      "RequireNonAlphanumeric": true,
      "RequireUppercase": true,
      "RequireLowercase": true
    }
  }
}
